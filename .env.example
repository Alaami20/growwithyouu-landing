# Production server-only settings. Never prefix secrets with VITE_.
CEO_VERIFIED_EMAIL=alaamiari@growwithyouu.com
ADMIN_ORIGIN=https://growwithyouu.com
# Preferred: generate locally with node scripts/hash-admin-password.mjs.
ADMIN_PASSWORD_HASH=
# Alternative: enter the password as a masked Vercel Secret. Ignored when a hash is set.
ADMIN_PASSWORD=
# Optional signing-key override: at least 32 random characters.
# Otherwise a random key is generated in private storage on first login.
ADMIN_SESSION_SECRET=
# Connect a PRIVATE Vercel Blob store to Production and enable its read/write token.
BLOB_READ_WRITE_TOKEN=
# Optional GitHub App installation. Install only on authorized repositories.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PROJECT_MAP={}
CRON_SECRET=
